parameters:
    level: 6
    paths:
        - app
        - database
        - config
        - routes
    ignoreErrors:
        # Laravel 13 dropped the forwarded-method @method annotations from
        # Eloquent\Builder (limit/orderBy are now forwarded via __call), so
        # Larastan resolves ->get() on those chains as Collection<int,stdClass>.
        # Upstream fix pending (larastan + laravel/framework stubs); the
        # runtime returns real models. Do NOT widen this pattern.
        -
            message: '#Parameter \#1 \$callback of method Illuminate\\Support\\Collection<int,stdClass>::map\(\)#'
            path: app

